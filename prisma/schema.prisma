// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider        = "prisma-client"
    output          = "../generated/prisma"
    previewFeatures = ["postgresqlExtensions"]
}

datasource db {
    provider = "postgresql"
    extensions = [vector()]
    schemas = ["public"]
}

// -------- Models --------

model Account {
    id        String @id @default(uuid())

    // authentication infos
    email     String @unique
    password  String
    type      AccountType

    // creation & update timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // relations
    user     User?
    employee Employee?

    @@schema("public")
}

model User {
    id        String @id @default(uuid())
    accountId String @unique // foreign key to Account

    // personal infos
    title     String?
    firstname String
    lastname  String
    gender    Gender
    genderText String? // in case the predefined genders do not fit
    pronoun  Pronoun?
    pronounText String? // in case the predefined pronouns do not fit
    birthdate DateTime // should this be required?
    phone     String?

    imageUrl  String? // maybe store images in a separate service like AWS S3 or Cloudinary? Byte is also possible, but not recommended for larger images

    // address infos
    country   String
    city      String
    zipCode   String
    street    String
    houseNumber String

    // creation & update timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // relations
    account Account @relation(fields: [accountId], references: [id])
    cases   Case[]
    appointments Appointment[]

    @@schema("public")
}
    
model Employee {
    id             String @id @default(uuid()) // primary key
    accountId      String @unique // foreign key to Account

    // personal infos
    title          String?
    firstname      String
    lastname       String
    pronoun       Pronoun?
    pronounText    String? // in case the predefined pronouns do not fit
    gender         Gender // maybe use an Enum here?
    genderText     String? // in case the predefined genders do not fit
    imageUrl       String? // maybe store images in a separate service like AWS S3 or Cloudinary? Byte is also possible, but not recommended for larger images
    phone          String?


    // organization infos
    organizationId String
    position       String?
    email          String // used for contacting purposes (not for Authentication)

    // profile infos
    description    String?
    expertiseAreas Area[]
    cv             String[]
    languages      Language[] // languages spoken by the employee


    // creation & update timestamps
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    // relations
    account      Account @relation(fields: [accountId], references: [id])
    organization Organization @relation(fields: [organizationId], references: [id])
    cases        Case[]
    appointments Appointment[]

    @@schema("public")
}


model Organization {
    id                 String @id @default(uuid()) // primary key

    // organization infos
    name               String
    description        String
    shortDescription   String
    email              String @unique   // Orga Email for contacting purposes (not for Authentication)
    phone              String?
    website            String?
    imageUrl           String? // maybe store images in a separate service like AWS S3 or Cloudinary? Byte is also possible, but not recommended for larger images
    accessibility      Accessibility[]

    expertiseAreas      Area[]
    type               OrganizationType
    priceCategory      PriceCategory

    // address infos
    country            String
    city               String
    zipCode            String
    street             String
    houseNumber        String

    // vector for similarity search
    expertiseVector    Unsupported("vector(3072)")?

    // rating infos
    averageRating      Float      @default(0)
    numberOfRatings    Int        @default(0)

    // creation & update timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  
    // relations
    services     Service[]
    employees    Employee[]
  
    @@index([expertiseAreas(ops: ArrayOps)], type: Gin)
    @@schema("public")
}

model Service {
    id                  String       @id @default(uuid()) // primary key
    organizationId      String       // foreign key to Organization

    // service infos
    title               String
    description         String
    type                ServiceType
    pricingModel        PricingModel @default(FIXED) // default pricing model is fixed pricing
    price               Float
    defaultDuration     Int @default(30) // default duration in minutes

    // creation & update timestamps
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt

    // relations
    organization Organization   @relation(fields: [organizationId], references: [id])

    @@schema("public")
}

model Case {
    id             String        @id @default(uuid())
    userId         String        // foreign key to User
    employeeId     String        // foreign key to Employee

    // case infos
    title          String
    description    String
    // documentsURL   String[]  // Are we sure we want to implement this now? Maybe store documents in a separate service like AWS S3 or Cloudinary? Byte is also possible, but not recommended for larger files
    status         CaseStatus    @default(OPEN)

    // creation & update timestamps
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    // relations
    user         User          @relation(fields: [userId], references: [id])
    employee     Employee     @relation(fields: [employeeId], references: [id])
    appointments Appointment[]

    @@schema("public")
}

model Appointment {
    id             String            @id @default(uuid()) // primary key
    caseId         String?          // foreign key to Case  
    userId         String           // foreign key to User
    employeeId     String           // foreign key to Employee

    // appointment infos
    duration       Int
    status         AppointmentStatus @default(OPEN)
    location       String?         // physical location or online meeting
    meetingLink    String?         // link for online meeting
    dateTimeStart  DateTime        // start date and time
    dateTimeEnd    DateTime        // end date and time
    notes          String?         // notes for the appointment

    // creation & update timestamps
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt

    // relations
    case         Case?         @relation(fields: [caseId], references: [id])
    user         User?         @relation(fields: [userId], references: [id])
    employee     Employee     @relation(fields: [employeeId], references: [id])

    @@schema("public")
}


// -------- Enums --------

enum AccountType {
    USER
    EMPLOYEE

    @@schema("public")
}

enum UserType {
    USER
    EMPLOYEE
    ADMIN

    @@schema("public")
}

enum OrganizationType {
    LAW_FIRM
    ASSOCIATION
    
    @@schema("public")
}

enum Gender {
  Agender           // without gender
  Bigender          // two identities simultaneously
  Demiboy           // partially male
  Demigirl          // partially female
  Frau              // female
  Mann              // male
  Nicht_binär       // non-binary
  Keine_Angabe      // no indication
  Andere            // if "Andere" is selected, pronounText can be used to specify
  
@@schema("public")
}

enum Pronoun {
    ER_IHN
    SIE_IHR
    HE_HIM
    SHE_HER
    THEY_THEM
    ZE_ZIR
    XE_XEM
    FAE_FAER
    VE_VER
    PER_PER
    E_EM
    Keine_Angabe
    Andere // if "Andere" is selected, pronounText can be used to specify

    @@schema("public")
}

enum Accessibility {
    Stufenloser_Zugang
    Rollstuhlgerecht
    Rampe_vorhanden
    Aufzug_vorhanden
    Behinderten_WC
    Parkplätze_vorhanden
    Blindenleitsystem

    Gebärdensprachliche_Begleitung
    Leichte_Sprache
    Assistenztiere_erlaubt
    
    @@schema("public")
}

enum ServiceType {
    INITIAL_CONSULTATION
    FOLLOW_UP_CONSULTATION
    DOCUMENT_REVIEW
    CASE_EVALUATION
    CORT_APPEARANCE
    MEDIATION_SESSION
    CLIENT_INTAKE
    LEAGAL_ADVICE
    STRATEGY_SESSION
    CASE_PROGRESSION
    REMOTE_CONSULTATION

    @@schema("public")
}
 
enum CaseStatus {
    OPEN
    IN_PROGRESS
    COMPLETED
    
    @@schema("public")
}

enum AppointmentStatus {
    CONFIRMED
    CANCELED
    OPEN
    COMPLETED

    @@schema("public")
}

enum PricingModel {
    FIXED
    HOURLY
  
    @@schema("public")
}

enum PriceCategory {
    FREE
    LOW
    MEDIUM
    HIGH

    @@schema("public")
}

