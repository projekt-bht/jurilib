  serviceID: {{serviceID}}
  organizationID: {{organizationID}}
}

body:json {
  {
    "description": "Hier gibts was zu sehen",
    "type": "DOCUMENT_REVIEW",
    "price": 23 
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
