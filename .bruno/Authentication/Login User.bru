meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/api/authentication/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{process.env.USER_MAIL}}",
    "password": "{{process.env.USER_PASSWORD}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
