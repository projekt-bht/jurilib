meta {
  name: Confirm Appointment
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/appointment/employee/:employeeID/:appointmentID/confirm
  body: none
  auth: inherit
}

params:path {
  appointmentID: {{appointmentID}}
  employeeID: {{employeeID}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "CONFIRMED",
    "userID": "bdf6f65e-47ed-40ff-b921-da2ba9c846e0"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
