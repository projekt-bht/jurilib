meta {
  name: Get single File
  type: http
  seq: 2
  tags: [
    Case
  ]
}

get {
  url: http://localhost:3000/api/case/:caseID/documents/?fileName=testwaage
  body: none
  auth: inherit
}

params:query {
  fileName: testwaage
}

params:path {
  caseID: {{caseID}}
}

settings {
  encodeUrl: true
  timeout: 0
}
