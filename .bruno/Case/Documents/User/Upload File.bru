meta {
  name: Upload File
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/api/case/:caseID/documents/user
  body: multipartForm
  auth: inherit
}

params:path {
  caseID: {{caseID}}
}

headers {
  ~private: true
}

body:multipart-form {
  file: 
  fileName: waage.png
}

settings {
  encodeUrl: true
  timeout: 0
}
