meta {
  name: Update Organization
  type: http
  seq: 3
}

patch {
  url: {{baseURL}}/organization/:organizationID
  body: json
  auth: inherit
}

params:path {
  organizationID: {{organizationID}}
}

body:json {
  {
    "name": "Testkanzlei",
